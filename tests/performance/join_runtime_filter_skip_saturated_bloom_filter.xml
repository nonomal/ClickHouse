<test>
    <!-- The build side has far more distinct keys than the largest statistics-sized Bloom filter can hold at the
         maximal ratio of set bits. From the second run on, the hash table statistics predict this, and the filter
         build is skipped instead of every build thread filling a filter that is discarded after the merge. -->
    <settings>
        <enable_join_runtime_filters>1</enable_join_runtime_filters>
        <join_algorithm>parallel_hash</join_algorithm>
        <collect_hash_table_stats_during_joins>1</collect_hash_table_stats_during_joins>
        <join_runtime_filter_size_from_hash_table_stats>1</join_runtime_filter_size_from_hash_table_stats>
        <query_plan_join_swap_table>0</query_plan_join_swap_table>
        <max_bytes_ratio_before_external_join>0</max_bytes_ratio_before_external_join>
    </settings>

    <create_query>CREATE TABLE rf_probe (k UInt64) ENGINE = MergeTree ORDER BY tuple()</create_query>
    <create_query>CREATE TABLE rf_build (k UInt64) ENGINE = MergeTree ORDER BY tuple()</create_query>

    <fill_query>INSERT INTO rf_probe SELECT number FROM numbers(1000000)</fill_query>
    <fill_query>INSERT INTO rf_build SELECT number * 2 FROM numbers(40000000)</fill_query>

    <query>SELECT count() FROM rf_probe INNER JOIN rf_build ON rf_probe.k = rf_build.k</query>

    <drop_query>DROP TABLE IF EXISTS rf_probe</drop_query>
    <drop_query>DROP TABLE IF EXISTS rf_build</drop_query>
</test>
